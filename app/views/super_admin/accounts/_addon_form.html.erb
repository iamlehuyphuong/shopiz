<hr class="my-8 border-n-weak">

<div class="main-content__body">
  <div class="flex items-center mb-6">
    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Resource Addons</h2>
    <div class="flex-grow border-t border-slate-100 ml-4"></div>
  </div>

  <div class="space-y-4">
    <div class="flex flex-col md:flex-row mb-4">
      <div class="attribute-label md:w-1/4">Active Addons</div>
      <div class="attribute-data md:w-3/4">
        <% if page.resource.account_addons.active.any? %>
          <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 inline-block min-w-[300px]">
            <ul class="space-y-2">
              <% page.resource.account_addons.active.each do |addon| %>
                <li class="flex items-center text-sm">
                  <div class="w-2 h-2 rounded-full bg-woot-400 mr-2"></div>
                  <span class="font-medium text-slate-700"><%= addon.addon_package&.name || 'Unknown Addon' %></span>
                  <span class="mx-2 text-slate-300">|</span>
                  <span class="text-slate-600"><%= addon.quantity %> <%= addon.addon_type.to_s.humanize %></span>
                  <% if addon.expired_at %>
                    <span class="ml-2 text-xs text-slate-400 italic">(Expires: <%= addon.expired_at.strftime('%d %b %Y') %>)</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <p class="text-slate-400 italic text-sm">No active addons</p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center justify-between bg-slate-50 p-6 rounded-xl border border-dashed border-slate-200">
      <div class="flex items-center space-x-4">
        <div class="bg-woot-50 p-3 rounded-lg text-woot-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-800">Add New Resources</h3>
          <p class="text-xs text-slate-500 mt-0.5">Purchase additional addon packages for this account.</p>
        </div>
      </div>
      <button type="button" class="button button--primary flex items-center space-x-2 shadow-sm" onclick="toggleAddonModal(true)">
        <span>Purchase Addon</span>
      </button>
    </div>

    <!-- Modal Dialog -->
    <div id="addon-purchase-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] hidden items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden transform transition-all animate-in fade-in zoom-in duration-200">
        <div class="px-8 py-6 border-b border-slate-100 flex items-center justify-between bg-white">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Purchase Addon Package</h3>
          <button type="button" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-50 rounded-full transition-all" onclick="toggleAddonModal(false)">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        
        <%= form_with url: purchase_addon_super_admin_account_path(page.resource), method: :post, local: true do |f| %>
          <div class="p-8 space-y-6">
            <div class="bg-amber-50 rounded-xl p-4 flex items-start space-x-3 border border-amber-100">
              <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="text-sm text-amber-800 leading-relaxed">Purchasing an addon will immediately increase the account's limits. Charges will be applied based on the package price.</p>
            </div>
            
            <div class="space-y-3">
              <%= f.label :addon_package_id, "Choose Addon Package", class: "text-[10px] font-bold text-slate-400 uppercase tracking-widest pl-1" %>
              <div class="relative">
                <%= f.select :addon_package_id, AddonPackage.all.map { |p| ["#{p.name} - #{p.quantity} #{p.addon_type.to_s.humanize} (#{p.price_amount} #{p.currency})", p.id] }, { include_blank: "Select a package to continue..." }, class: "select border-slate-200 bg-slate-50 focus:bg-white focus:ring-woot-500 focus:border-woot-500 rounded-xl w-full py-4 px-4 text-sm transition-all appearance-none" %>
              </div>
            </div>
          </div>
          
          <div class="px-8 py-6 bg-slate-50/50 flex items-center justify-end space-x-4 border-t border-slate-100">
            <button type="button" class="px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors" onclick="toggleAddonModal(false)">Cancel</button>
            <%= f.submit "Confirm and Purchase", class: "button button--primary px-8 py-2.5 rounded-lg shadow-lg shadow-woot-200" %>
          </div>
        <% end %>
      </div>
    </div>

    <script>
      function toggleAddonModal(show) {
        const modal = document.getElementById('addon-purchase-modal');
        if (show) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        } else {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = 'auto';
        }
      }

      // Close on backdrop click
      document.getElementById('addon-purchase-modal').addEventListener('click', function(e) {
        if (e.target === this) toggleAddonModal(false);
      });

      // Escape key to close
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') toggleAddonModal(false);
      });
    </script>
  </div>
</div>
