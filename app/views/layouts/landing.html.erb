<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0">
  <title>Shopiz - Nền tảng Chăm sóc khách hàng Đa kênh Toàn diện</title>
  
  <!-- Primary Meta Tags -->
  <meta name="title" content="Shopiz - Nền tảng Chăm sóc khách hàng Đa kênh Toàn diện">
  <meta name="description" content="Shopiz là giải pháp chăm sóc khách hàng đa kênh toàn diện. Hội tụ tin nhắn từ Facebook, Zalo, TikTok, Website về một nơi, kết hợp cùng trợ lý AI tự động chốt đơn 24/7.">
  <meta name="keywords" content="phần mềm quản lý bán hàng, chăm sóc khách hàng đa kênh, chatbot AI, trợ lý AI, quản lý tin nhắn, CRM, Shopiz">
  <meta name="author" content="Shopiz">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://shopiz.pro/">
  <meta property="og:title" content="Shopiz - Nền tảng Chăm sóc khách hàng Đa kênh Toàn diện">
  <meta property="og:description" content="Shopiz là giải pháp chăm sóc khách hàng đa kênh toàn diện. Hội tụ tin nhắn từ Facebook, Zalo, TikTok, Website về một nơi, kết hợp cùng trợ lý AI tự động chốt đơn 24/7.">
  <meta property="og:image" content="/og-image.jpg">
  <meta property="og:site_name" content="Shopiz">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://shopiz.pro/">
  <meta property="twitter:title" content="Shopiz - Nền tảng Chăm sóc khách hàng Đa kênh Toàn diện">
  <meta property="twitter:description" content="Shopiz là giải pháp chăm sóc khách hàng đa kênh toàn diện. Hội tụ tin nhắn từ Facebook, Zalo, TikTok, Website về một nơi, kết hợp cùng trợ lý AI tự động chốt đơn 24/7.">
  <meta property="twitter:image" content="/og-image.jpg">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Shopiz",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "url": "https://shopiz.pro",
    "description": "Nền tảng chăm sóc khách hàng đa kênh và trợ lý AI tự động hóa bán hàng dành cho doanh nghiệp.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "VND"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Shopiz",
      "url": "https://shopiz.pro"
    }
  }
  </script>

  <link class="favicon" rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link class="favicon" rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link class="favicon" rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN for Landing Page -->
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        container: {
          center: true,
          screens: {
            sm: '100%',
            md: '768px',
            lg: '1024px',
            xl: '1200px',
            '2xl': '1200px',
          }
        },
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            primary: {
              50: '#fff7ed',
              100: '#ffedd5',
              400: '#fb923c',
              500: '#f97316',
              600: '#E06720', // App's brand color
              700: '#c2410c',
            },
            dark: {
              bg: '#050a15',
              card: '#0f172a',
              border: '#1e293b'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
      font-family: 'Inter', sans-serif;
    }
    
    /* Hiệu ứng mờ nền phía sau hero */
    .hero-glow {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 400px;
      background: radial-gradient(circle, rgba(224, 103, 32, 0.15) 0%, rgba(5, 10, 21, 0) 70%);
      z-index: -1;
      pointer-events: none;
    }
  </style>
</head>
<body class="antialiased min-h-screen text-slate-600">
  <%= render 'home/header_navigation' %>
  <%= yield %>
  <%= render 'home/footer' %>
</body>
</html>
