<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Shopiz Email</title>
    <style type="text/css">
        body { background-color: #F1F5F9; font-family: 'Nunito Sans', Helvetica, Arial, sans-serif; margin: 0; -webkit-font-smoothing: antialiased; }
        img { max-width: 100%; border: none; text-decoration: none; }
        
        @media only screen and (max-width: 640px) {
            .container { width: 100% !important; padding: 10px !important; }
            .content-wrap { padding: 25px 20px !important; }
            .header-box { padding: 25px 20px !important; }
        }
    </style>
</head>
<body style="background-color: #F1F5F9;">
    {% assign brand_color = '#3b82f6' %}
    {% assign brand_label = 'Notice' %}

    {% if mailer_action == 'account_deleted' or mailer_action == 'account_deletion_for_inactivity' or mailer_action == 'account_deletion_user_initiated' or mailer_action == 'automation_rule_disabled' or mailer_action contains 'disconnect' or mailer_action == 'contact_import_failed' or mailer_action contains 'sla_missed' %}
      {% assign brand_color = '#ef4444' %}
      {% assign brand_label = 'Critical' %}
    {% elsif mailer_action == 'unlock_instructions' or mailer_action == 'password_change' %}
      {% assign brand_color = '#f59e0b' %}
      {% assign brand_label = 'Warning' %}
    {% endif %}

    <table width="100%" bgcolor="#F1F5F9" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td class="container" width="600" style="display: block; margin: 0 auto; max-width: 600px; padding: 30px 0;">
                
                <table width="100%" bgcolor="#ffffff" style="border-radius: 24px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); border-top: 5px solid #F97316;">
                    
                    <tr>
                        <td class="header-box" style="background: linear-gradient(180deg, #FFF7ED 0%, #FFFFFF 100%); padding: 30px 20px; text-align: center;">
                            <img src="{% if global_config['BRAND_URL'] != '' %}{{ global_config['BRAND_URL'] }}{% else %}https://shopiz.pro{% endif %}/brand-assets/logo_thumbnail.svg" width="80" alt="Shopiz" style="display: block; margin: 0 auto;" />
                            
                            <div style="margin-top: 8px; color: #F97316; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;">
                                {% if global_config['BRAND_NAME'] != '' %}{{ global_config['BRAND_NAME'] }}{% else %}SHOPIZ{% endif %}
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 0 45px;">
                            <div style="height: 1px; width: 100%; background-color: #FEE2E2; opacity: 0.5;"></div>
                        </td>
                    </tr>

                    <tr>
                        <td class="content-wrap" style="padding: 35px 45px 45px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="padding-bottom: 25px; text-align: left;">
                                        <span style="display: inline-block; padding: 6px 16px; background-color: {{ brand_color }}; color: #ffffff; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">
                                            {{ brand_label }}
                                        </span>
                                    </td>
                                </tr>
                                {{ content_for_layout }}
                            </table>
                        </td>
                    </tr>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td style="text-align: center; padding: 25px 20px; font-size: 12px; color: #94A3B8;">
                            <p style="margin: 0 0 5px;">&copy; {{ "now" | date: "%Y" }} <strong>{% if global_config['BRAND_NAME'] != '' %}{{ global_config['BRAND_NAME'] }}{% else %}Shopiz{% endif %}</strong>. All Rights Reserved.</p>
                            <div style="margin-top: 5px;">
                                <a href="{% if global_config['BRAND_URL'] != '' %}{{ global_config['BRAND_URL'] }}{% else %}https://shopiz.pro{% endif %}" style="color: #F97316; text-decoration: none; font-weight: 600;">Website</a>
                            </div>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>
</body>
</html>
