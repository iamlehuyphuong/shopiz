<!-- 3. Logos / Trust Section -->
<style>
  @keyframes infinite-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 4rem)); } /* 4rem corresponds to gap-16 */
  }
  .animate-infinite-scroll {
    animation: infinite-scroll 25s linear infinite;
  }
  .logos-container:hover .animate-infinite-scroll {
    animation-play-state: paused;
  }
  .mask-edges {
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }
</style>

<section class="py-16 bg-slate-50 border-b border-slate-100 overflow-hidden">
  <div class="container mx-auto px-4 max-w-6xl text-center mb-10">
    <p class="text-sm font-bold text-slate-500 uppercase tracking-widest">
      Tích hợp hoàn hảo với các nền tảng hàng đầu
    </p>
  </div>
  
  <% 
    logos = [
      { file: 'messenger-icon.webp', alt: 'Messenger' },
      { file: 'instagram-icon.webp', alt: 'Instagram' },
      { file: 'tiktok-icon.webp', alt: 'TikTok' },
      { file: 'zalo-icon.svg', alt: 'Zalo' },
      { file: 'telegram-icon.webp', alt: 'Telegram' },
      { file: 'woocommerce.webp', alt: 'WooCommerce' },
      { file: 'kiotviet.webp', alt: 'KiotViet' },
      { file: 'shopify-icon.webp', alt: 'Shopify' },
      { file: 'tingee.webp', alt: 'Tingee' },
      { file: 'sepay.webp', alt: 'SePay' },
      { file: 'payos.webp', alt: 'PayOS' }
    ]
  %>

  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Marquee Container -->
    <div class="logos-container mask-edges flex gap-16 w-full whitespace-nowrap relative overflow-hidden">
      
      <!-- First Set -->
      <div class="flex shrink-0 items-center justify-around gap-16 animate-infinite-scroll py-4">
        <% logos.each do |logo| %>
          <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-2xl flex items-center justify-center p-4 sm:p-6 hover:bg-white hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-pointer">
            <%= image_tag logo[:file], alt: logo[:alt], class: 'w-full h-full object-contain drop-shadow-sm' %>
          </div>
        <% end %>
      </div>
      
      <!-- Second Set (Duplicate for seamless loop) -->
      <div class="flex shrink-0 items-center justify-around gap-16 animate-infinite-scroll py-4">
        <% logos.each do |logo| %>
          <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-2xl flex items-center justify-center p-4 sm:p-6 hover:bg-white hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-pointer">
            <%= image_tag logo[:file], alt: logo[:alt], class: 'w-full h-full object-contain drop-shadow-sm' %>
          </div>
        <% end %>
      </div>
      
    </div>
  </div>
</section>
