<!-- 1. Header / Navigation -->
<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <img src="/brand-assets/logo_thumbnail.svg" class="w-8 h-8" alt="Shopiz" />
      <span class="font-bold text-xl text-slate-900 tracking-tight">Shopiz</span>
    </div>
    
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href="#" class="text-slate-600 hover:text-primary-600 transition">Sản phẩm</a>
      <a href="#" class="text-slate-600 hover:text-primary-600 transition">Giải pháp</a>
      <a href="#" class="text-slate-600 hover:text-primary-600 transition">Bảng giá</a>
      <a href="#" class="text-slate-600 hover:text-primary-600 flex items-center gap-1 transition">
        Tài nguyên
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
      </a>
    </nav>
    
    <% if current_user %>
      <div class="flex items-center gap-4">
        <% if current_user.avatar_url.present? %>
          <img src="<%= current_user.avatar_url %>" alt="<%= current_user.name %>" class="w-8 h-8 rounded-full border border-slate-200 object-cover" />
        <% else %>
          <div class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-sm font-medium text-white border border-slate-200">
            <%= current_user.name.to_s[0]&.upcase || 'U' %>
          </div>
        <% end %>
        <a href="/app" class="text-sm font-medium bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition shadow-lg shadow-primary-500/20">Truy cập ứng dụng</a>
      </div>
    <% else %>
      <div class="flex items-center gap-4">
        <a href="/app/login" class="text-sm font-medium bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition shadow-lg shadow-primary-500/20">Dùng thử miễn phí</a>
      </div>
    <% end %>
  </div>
</header>

