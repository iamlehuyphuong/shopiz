<!-- 2. Hero Section -->
<section class="relative pt-24 pb-16 overflow-hidden">
  <div class="hero-glow"></div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-0 items-center">
      <!-- Left Column: Content -->
      <div class="lg:col-span-6 relative z-20 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-xs font-medium text-slate-600 mb-6">
          <span class="flex h-2 w-2 rounded-full bg-primary-500"></span>
          Nền tảng CSKH bằng AI
        </div>
        
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-slate-900 mb-6 leading-tight">
          X3 doanh số với <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-primary-500">Trợ lý AI đa kênh</span>
        </h1>
        
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl">
          Quản lý tập trung toàn bộ tin nhắn từ Facebook, Zalo, TikTok, Website về một màn hình. Tự động hoá tư vấn, bán hàng và thanh toán với trí tuệ nhân tạo.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 mb-8">
          <a href="/app/login" class="w-full sm:w-auto text-base font-medium bg-primary-600 hover:bg-primary-700 text-white px-8 py-3.5 rounded-lg transition shadow-lg shadow-primary-500/20 flex items-center justify-center gap-2">
            Bắt đầu miễn phí ngay
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href="#" class="w-full sm:w-auto text-base font-medium bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 px-8 py-3.5 rounded-lg transition flex items-center justify-center gap-2">
            <svg class="w-5 h-5 text-slate-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
            Xem Demo
          </a>
        </div>
        
        <div class="flex flex-wrap items-center gap-6 text-sm text-slate-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Không cần thẻ tín dụng
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Dùng thử 14 ngày
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Hủy bất cứ lúc nào
          </span>
        </div>
      </div>
      
      <!-- Right Column: Image/Mockup -->
      <div class="lg:col-span-6 relative z-10 w-full mt-10 lg:mt-0 lg:-ml-12 lg:-mr-12">
        <div class="relative">

          <%= image_tag "hero.png", alt: "Shopiz Dashboard", class: "w-full h-auto object-cover drop-shadow-2xl hover:scale-105 transition-transform duration-700" %>
        </div>
      </div>
    </div>
  </div>
</section>

