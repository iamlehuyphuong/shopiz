<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field !max-w-none">
  <div class="space-y-8">
    <% field.categorized_features.each do |category, features| %>
      <div class="mt-8 mb-6 first:mt-0">
        <div class="flex items-center mb-4 px-1">
          <h3 class="text-sm font-bold text-black uppercase tracking-wider"><%= category %></h3>
          <div class="flex-grow border-t border-n-weak ml-4"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <% features.each do |feature_name, enabled| %>
            <div class="flex items-start p-3 border border-n-weak rounded-lg bg-white hover:border-n-orange transition-all duration-200 group relative">
              <div class="flex items-center h-5">
                <%= hidden_field_tag "#{f.object_name}[features][#{feature_name}]", "false" %>
                <%= check_box_tag "#{f.object_name}[features][#{feature_name}]", "true", enabled, 
                    id: "#{f.object_name}_features_#{feature_name}",
                    class: "h-4 w-4 rounded border-n-strong text-n-orange focus:ring-n-orange cursor-pointer" %>
              </div>
              <label for="<%= f.object_name %>_features_<%= feature_name %>" class="ml-3 text-xs flex flex-col cursor-pointer select-none">
                <span class="font-bold text-black group-hover:text-n-orange transition-colors"><%= SuperAdmin::AccountFeaturesHelper.feature_display_names[feature_name] || field.resource.class.human_attribute_name(feature_name) %></span>
                <span class="mt-1 text-[10px] font-mono text-n-muted uppercase tracking-tighter"><%= feature_name %></span>
              </label>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
